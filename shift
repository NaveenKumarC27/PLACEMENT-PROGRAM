import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner in= new Scanner(System.in);
        int n=in.nextInt();
        for(int i=0;i<n;i++)
        {
            String str=in.next();
            int r=in.nextInt();
            int l=str.length();
            r=r%l;
            String s="";
            if((i%2==0))
            {
                s=str.substring(r)+str.substring(0,r);
            }
            else
            {
                s=str.substring(l-r)+str.substring(0,l-r);
            }
            System.out.println(s);
        }
    }
}
