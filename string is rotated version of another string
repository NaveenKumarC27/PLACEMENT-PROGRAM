import java.util.*;
public class main{
    public static void main(String[] args)
    {
        Scanner in = new Scanner(System.in);
        int a=in.nextInt();
        for(int j=0;j<a;j++)
        {
        String s=in.next();
        String r=in.next();
        int f=0;
        for(int i=0;i<s.length();i++)
        {
            String str="";
            int l=s.length();
            int n=i;
            n=i%l;
            str=s.substring(n)+s.substring(0,n);
            if(str.equals(r))
            {
                f=1;
                break;
            }
        }
        if(f==1){
            System.out.println("true");
        }
        else
        {
            System.out.println("false");
        }
        }
    }
}
